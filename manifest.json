{
  "manifest_version": 3,
  "name": "Wåkostå (Wakosta) voor IKEA BE/NL/DE prijzen",
  "version": "1.0.1",
  "description": "Vergelijk IKEA prijzen in BE, NL en DE. Ontdek direct met Wakosta (Wåkostå) of je meubels over de grens goedkoper zijn!",
  "permissions": [],
  "host_permissions": [
    "*://*.ikea.com/*",
    "*://www.ikea.be/*",
    "*://www.ikea.nl/*",
    "*://www.ikea.de/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ikea.com/*",
        "*://*.ikea.be/*",
        "*://*.ikea.nl/*",
        "*://*.ikea.de/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Wåkostå (Wakosta) Prijsvergelijker",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}